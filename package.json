{
	"name": "list-vibes",
	"version": "0.1.0",
	"description": "A Microsoft To Do-style task UI over a plain folder of markdown files.",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node test/build-model.mjs && node --test test/*.test.mjs",
		"lint": "eslint src",
		"harness": "node harness/build.mjs",
		"shot": "node harness/build.mjs && node harness/shot.mjs",
		"dev:vault": "node scripts/dev-vault.mjs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "dkthecoder",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"playwright": "^1.62.1",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dkthecoder/list-vibes"
	}
}
